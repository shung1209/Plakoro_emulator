[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/ui/PreBattleDiceSetupUI.gd" id="1_ui"]

[ext_resource type="Script" path="res://scripts/ui/GlobalQuitConfirmation.gd" id="quit_guard"]

[node name="PreBattleDiceSetupUI" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_ui")

[node name="QuitGuard" type="Node" parent="."]
script = ExtResource("quit_guard")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.055, 0.071, 0.11, 1)

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 24.0
offset_top = 24.0
offset_right = -24.0
offset_bottom = -24.0
grow_horizontal = 2
grow_vertical = 2

[node name="Main" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Margin/Main"]
layout_mode = 2
theme_override_font_sizes/font_size = 28
text = "Pre-Battle Enerkoro Setup"

[node name="RuleText" type="Label" parent="Margin/Main"]
layout_mode = 2
autowrap_mode = 2
text = "Choose all six faces for each die. Across the three dice, the six fixed-energy faces must use six different energy types. Double-energy faces may contain two identical or two different energies."

[node name="DiceScroll" type="ScrollContainer" parent="Margin/Main"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 2

[node name="DiceContainer" type="HBoxContainer" parent="Margin/Main/DiceScroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 12

[node name="BottomSplit" type="HSplitContainer" parent="Margin/Main"]
layout_mode = 2
custom_minimum_size = Vector2(0, 220)
split_offset = 540

[node name="ValidationPanel" type="PanelContainer" parent="Margin/Main/BottomSplit"]
layout_mode = 2

[node name="ValidationBox" type="VBoxContainer" parent="Margin/Main/BottomSplit/ValidationPanel"]
layout_mode = 2

[node name="ValidationTitle" type="Label" parent="Margin/Main/BottomSplit/ValidationPanel/ValidationBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "Validation"

[node name="ValidationLabel" type="Label" parent="Margin/Main/BottomSplit/ValidationPanel/ValidationBox"]
unique_name_in_owner = true
layout_mode = 2
autowrap_mode = 2
text = "Validation result"

[node name="ProbabilityPanel" type="PanelContainer" parent="Margin/Main/BottomSplit"]
layout_mode = 2

[node name="ProbabilityLabel" type="Label" parent="Margin/Main/BottomSplit/ProbabilityPanel"]
unique_name_in_owner = true
layout_mode = 2
autowrap_mode = 2
text = "Probability"

[node name="ActionRow" type="HBoxContainer" parent="Margin/Main"]
layout_mode = 2

[node name="LoadDefaultButton" type="Button" parent="Margin/Main/ActionRow"]
